# Local Development Environment Variables
# This file is for local development only and should not be committed to git
# Copy this file to .env.local and customize for your local setup

# ==============================================
# Local EmailJS Configuration (Development)
# ==============================================
# Use test/development EmailJS credentials here
# REACT_APP_EMAILJS_SERVICE_ID=your_dev_service_id
# REACT_APP_EMAILJS_TEMPLATE_ID=your_dev_template_id
# REACT_APP_EMAILJS_PUBLIC_KEY=your_dev_public_key

# ==============================================
# Local Development URLs
# ==============================================
# Local development website URL
# REACT_APP_WEBSITE_URL=http://localhost:3000

# ==============================================
# Development Tools
# ==============================================
# Enable React Developer Tools
REACT_APP_DEV_TOOLS=true

# Enable detailed error messages
REACT_APP_DEBUG_MODE=true

# ==============================================
# Local API Configuration
# ==============================================
# Local backend API URL
# REACT_APP_API_URL=http://localhost:5000/api

# ==============================================
# Testing Configuration
# ==============================================
# Disable email sending in tests
# REACT_APP_DISABLE_EMAIL_IN_TESTS=true