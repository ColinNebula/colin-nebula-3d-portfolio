# Production Environment Variables
# These settings are optimized for production deployment

# ==============================================
# Production Build Configuration
# ==============================================
# Disable source maps in production for security
GENERATE_SOURCEMAP=false

# Disable development tools
REACT_APP_DEV_TOOLS=false
REACT_APP_DEBUG_MODE=false

# ==============================================
# Performance Optimizations
# ==============================================
# Disable ESLint warnings as errors in production builds
ESLINT_NO_DEV_ERRORS=true

# ==============================================
# Production URLs
# ==============================================
# Production website URL
REACT_APP_WEBSITE_URL=https://colin-nebula-portfolio.netlify.app

# ==============================================
# Analytics (Uncomment if using Google Analytics)
# ==============================================
# REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX