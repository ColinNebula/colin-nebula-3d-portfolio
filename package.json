{
  "name": "colin-nebula-3d-portfolio",
  "version": "0.1.0",
  "private": true,
  "homepage": "https://colinnebula.github.io/colin-nebula-3d-portfolio",
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@testing-library/jest-dom": "^5.16.4",
    "@testing-library/react": "^13.3.0",
    "@testing-library/user-event": "^13.5.0",
    "bootstrap": "^5.2.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "react": "^18.2.0",
    "react-bootstrap": "^2.4.0",
    "react-dom": "^18.2.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.3.0",
    "react-scripts": "5.0.1",
    "react-social-icons": "^6.24.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "kill-ports": "node scripts/kill-ports.js",
    "kill-ports-all": "node scripts/kill-ports.js --all",
    "kill-ports-force": "node scripts/kill-ports.js --kill-all",
    "dev-clean": "node scripts/kill-ports.js 3000 && npm start",
    "dev": "npm start",
    "serve": "serve -s build -l 3000",
    "favicon-generator": "node scripts/create-bordered-favicon.js",
    "api-install": "cd api-server && npm install",
    "api-start": "cd api-server && npm start",
    "api-dev": "cd api-server && npm run dev",
    "api-setup": "cd api-server && npm run setup-db",
    "setup-mysql": "cd api-server && node scripts/setup-mysql.js",
    "dev-with-api": "concurrently \"npm run api-dev\" \"npm start\"",
    "setup-api": "npm run api-install && echo 'API server dependencies installed. Run npm run dev-with-api to start both servers.'"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "gh-pages": "^4.0.0",
    "serve": "^14.0.0",
    "concurrently": "^8.2.2"
  }
}
