# Environment Configuration for Colin Nebula 3D Portfolio
# Note: Only variables prefixed with REACT_APP_ are accessible in React client-side code

# ==============================================
# EmailJS Configuration
# ==============================================
# Get these values from your EmailJS dashboard at https://www.emailjs.com/
REACT_APP_EMAILJS_SERVICE_ID=service_64j2mwd
REACT_APP_EMAILJS_TEMPLATE_ID=__ejs-test-mail-service__
REACT_APP_EMAILJS_PUBLIC_KEY=o7n5LE_OHI9NfL2eU

# ==============================================
# Application Configuration
# ==============================================
# Website URL for links and references
REACT_APP_WEBSITE_URL=https://colin-nebula-portfolio.netlify.app
REACT_APP_WEBSITE_NAME=Colin Nebula 3D Portfolio

# Portfolio homepage path (for GitHub Pages deployment)
REACT_APP_HOMEPAGE=/colin-nebula-3d-portfolio

# ==============================================
# Development Configuration
# ==============================================
# Development server port (default: 3000)
PORT=3000

# Browser auto-open on start (default: true)
BROWSER=true

# Generate source maps for easier debugging (default: true in development)
GENERATE_SOURCEMAP=true

# ==============================================
# Build Configuration
# ==============================================
# Disable ESLint warnings as errors in build (useful for production)
ESLINT_NO_DEV_ERRORS=true
DISABLE_ESLINT_PLUGIN=false

# ==============================================
# Performance and Analytics (Optional)
# ==============================================
# Google Analytics Tracking ID (uncomment and add your ID if needed)
# REACT_APP_GA_TRACKING_ID=G-XXXXXXXXXX

# ==============================================
# Social Media Links (Optional)
# ==============================================
# Add your social media links here for easy configuration
# REACT_APP_GITHUB_URL=https://github.com/ColinNebula
# REACT_APP_LINKEDIN_URL=https://linkedin.com/in/your-profile
# REACT_APP_TWITTER_URL=https://twitter.com/your-handle
# REACT_APP_INSTAGRAM_URL=https://instagram.com/your-handle

# ==============================================
# API Configuration (For future backend integration)
# ==============================================
# Backend API URL (uncomment when you add a backend)
# REACT_APP_API_URL=http://localhost:5000/api
# REACT_APP_API_TIMEOUT=10000

# ==============================================
# Feature Flags (Optional)
# ==============================================
# Enable/disable features for testing
REACT_APP_ENABLE_NOTIFICATIONS=true
REACT_APP_ENABLE_ANALYTICS=false
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_ENABLE_PORTFOLIO_ANIMATIONS=true
REACT_APP_ENABLE_CONTACT_FORM=true

# ==============================================
# Security (Optional)
# ==============================================
# Content Security Policy settings
REACT_APP_CSP_ENABLED=false

# ==============================================
# Theme Configuration (Optional)
# ==============================================
# Default theme preference
REACT_APP_DEFAULT_THEME=dark
REACT_APP_THEME_STORAGE_KEY=nebula_theme_preference

# ==============================================
# Performance Settings
# ==============================================
# Image lazy loading
REACT_APP_ENABLE_LAZY_LOADING=true
# Maximum portfolio items to load initially
REACT_APP_INITIAL_PORTFOLIO_LOAD=12
# Animation performance mode (high/medium/low)
REACT_APP_ANIMATION_PERFORMANCE=high